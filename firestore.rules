rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isNotDemoAccount() {
      return !isSignedIn() || (
        request.auth.token.demo_super_admin != true &&
        request.auth.token.account_type != 'DEMO' &&
        request.auth.token.email != 'demo-admin@sbkhush.com'
      );
    }

    function isDemoSuperAdmin() {
      return isSignedIn() &&
        request.auth.token.demo_super_admin == true &&
        request.auth.token.account_type == 'DEMO' &&
        request.auth.token.email == 'demo-admin@sbkhush.com';
    }

    function isSuperAdminEmail() {
      return isSignedIn() &&
        isNotDemoAccount() &&
        request.auth.token.email == 'hasanaamir815@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function isSuperAdmin() {
      return isSignedIn() && isNotDemoAccount() && (
        request.auth.token.super_admin == true ||
        isSuperAdminEmail() ||
        exists(/databases/$(database)/documents/platform_admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin')
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.@]+$');
    }

    function isValidSlug(slug) {
      return slug is string &&
        slug.size() >= 2 &&
        slug.size() <= 60 &&
        slug.matches('^[a-z0-9\\-]+$') &&
        !(slug in [
          'admin', 'super-admin', 'dashboard', 'login', 'merchant', 'register', 'api',
          's', 'shop', 'cart', 'checkout', 'account', 'tracking',
          'platform', 'pricing', 'about', 'faq', 'terms', 'privacy',
          'privacy-policy', 'terms-and-conditions', 'contact',
          'salesman', 'sales-manager', 'referral', 'r'
        ]);
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAllowedSalesRole(role) {
      return role in ['salesman', 'senior_salesman', 'sales_manager', 'referral_agent'];
    }

    function hasSalesClaimRole(roles) {
      return isSignedIn() && isNotDemoAccount() && (
        isSuperAdmin() ||
        (request.auth.token.sales_role in roles) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in roles)
      );
    }

    function isManagerOfSalesMember(memberId) {
      return isSignedIn() && isNotDemoAccount() &&
        exists(/databases/$(database)/documents/salesMembers/$(memberId)) &&
        get(/databases/$(database)/documents/salesMembers/$(memberId)).data.assignedManagerUid == request.auth.uid;
    }

    function isShopOwner(shopId) {
      return isSignedIn() && isNotDemoAccount() && (
        (exists(/databases/$(database)/documents/shops/$(shopId)) &&
         get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid) ||
        (exists(/databases/$(database)/documents/shops/$(shopId)/staff/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/shops/$(shopId)/staff/$(request.auth.uid)).data.role == 'shop_owner' &&
         get(/databases/$(database)/documents/shops/$(shopId)/staff/$(request.auth.uid)).data.status == 'active')
      );
    }

    function isShopAdmin(shopId) {
      return isSignedIn() && isNotDemoAccount() && (
        isSuperAdmin() ||
        isShopOwner(shopId) ||
        (exists(/databases/$(database)/documents/shops/$(shopId)/staff/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/shops/$(shopId)/staff/$(request.auth.uid)).data.status == 'active' &&
         get(/databases/$(database)/documents/shops/$(shopId)/staff/$(request.auth.uid)).data.role in ['shop_owner', 'shop_admin'])
      );
    }

    function isShopMember(shopId) {
      return isSignedIn() && isNotDemoAccount() && (
        isSuperAdmin() ||
        isShopOwner(shopId) ||
        (exists(/databases/$(database)/documents/shops/$(shopId)/staff/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/shops/$(shopId)/staff/$(request.auth.uid)).data.status == 'active')
      );
    }

    function hasShopPermission(shopId, perm) {
      return isShopAdmin(shopId) || (
        isSignedIn() && isNotDemoAccount() &&
        exists(/databases/$(database)/documents/shops/$(shopId)/staff/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/shops/$(shopId)/staff/$(request.auth.uid)).data.status == 'active' &&
        perm in get(/databases/$(database)/documents/shops/$(shopId)/staff/$(request.auth.uid)).data.permissions
      );
    }

    function isValidReview(data) {
      return data.keys().hasAll(['productId', 'userId', 'userName', 'rating', 'comment', 'createdAt']) &&
        data.productId is string && data.productId.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 100 &&
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        data.comment is string && data.comment.size() >= 1 && data.comment.size() <= 1000 &&
        data.createdAt is string && data.createdAt.size() <= 50;
    }

    function isValidOrderCreate(data) {
      return data.keys().hasAll(['id', 'orderNumber', 'userId', 'customer', 'items', 'total', 'paymentMethod', 'paymentStatus', 'orderStatus', 'trackingTokenHash', 'createdAt']) &&
        data.orderNumber is string && data.orderNumber.size() <= 30 &&
        data.trackingTokenHash is string && data.trackingTokenHash.size() == 64 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.customer is map &&
        data.items is list && data.items.size() > 0 && data.items.size() <= 100 &&
        data.total is number && data.total >= 0 &&
        data.paymentMethod in ['cod', 'bank_transfer', 'easypaisa', 'jazzcash', 'online'] &&
        data.paymentStatus == 'pending' &&
        data.orderStatus == 'Pending' &&
        (!('fulfillmentMethod' in data) || data.fulfillmentMethod in ['delivery', 'self_pickup']) &&
        (!('pickupDetails' in data) || data.pickupDetails is map) &&
        (!('pickupStatus' in data) || data.pickupStatus in ['New Pickup Order', 'Preparing', 'Ready for Pickup', 'Picked Up', 'Cancelled']) &&
        (!('pickupShopId' in data) || (data.pickupShopId is string && data.pickupShopId.size() <= 128)) &&
        (!('pickupAddress' in data) || (data.pickupAddress is string && data.pickupAddress.size() <= 500)) &&
        (!('pickupDate' in data) || (data.pickupDate is string && data.pickupDate.size() <= 20)) &&
        (!('pickupTimeSlot' in data) || (data.pickupTimeSlot is string && data.pickupTimeSlot.size() <= 120)) &&
        (!('pickupInstructions' in data) || (data.pickupInstructions is string && data.pickupInstructions.size() <= 500)) &&
        (!('paymentProofImage' in data) || (data.paymentProofImage is string && data.paymentProofImage.size() <= 300000));
    }

    // Non-PII public tracking view: strictly forbids customer.email, phone, address, paymentProofImage
    function isValidOrderTracking(data) {
      return data.keys().hasAll(['orderNumber', 'orderId', 'orderStatus', 'paymentMethod', 'paymentStatus', 'customerName', 'city', 'items', 'total', 'trackingTokenHash', 'createdAt']) &&
        data.keys().hasOnly(['orderNumber', 'orderId', 'shopId', 'orderStatus', 'fulfillmentMethod', 'pickupDetails', 'paymentMethod', 'paymentStatus', 'courierName', 'trackingNumber', 'customerName', 'city', 'items', 'total', 'trackingTokenHash', 'createdAt', 'updatedAt']) &&
        data.orderNumber is string && data.orderNumber.size() <= 30 &&
        data.orderId is string && data.orderId.size() <= 128 &&
        data.trackingTokenHash is string && data.trackingTokenHash.size() == 64 &&
        data.customerName is string && data.customerName.size() <= 120 &&
        data.city is string && data.city.size() <= 80 &&
        data.items is list && data.items.size() > 0 && data.items.size() <= 100 &&
        data.total is number && data.total >= 0 &&
        (!('fulfillmentMethod' in data) || data.fulfillmentMethod in ['delivery', 'self_pickup']) &&
        (!('pickupDetails' in data) || data.pickupDetails is map);
    }

    function isValidContactMessage(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'message', 'status', 'createdAt']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 2000 &&
        data.status == 'new';
    }

    function isValidShopPublicDoc(data, shopId) {
      return data.keys().hasAll(['id', 'slug', 'name', 'status']) &&
        data.keys().hasOnly([
          'id', 'slug', 'name', 'businessType', 'logoUrl', 'city',
          'publicContactPhone', 'publicSupportEmail', 'storefrontAddress',
          'businessHours', 'seoTitle', 'seoDescription',
          'ogImageUrl', 'websiteUrl', 'socialLinks',
          'theme', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.id == shopId &&
        isValidSlug(data.slug) &&
        data.status in ['active', 'inactive', 'suspended'];
    }

    // ====================================================
    // PLATFORM SUPER ADMIN COLLECTIONS
    // ====================================================

    match /platform_admins/{adminId} {
      allow get: if isValidId(adminId) && (isSuperAdmin() || (isSignedIn() && request.auth.uid == adminId));
      allow list: if isSuperAdmin();
      allow create, update, delete: if isValidId(adminId) && (
        isSuperAdmin() ||
        (isSuperAdminEmail() && adminId == request.auth.uid)
      );
    }

    match /platform_settings/{docId} {
      allow read: if true;
      allow create, update, delete: if isValidId(docId) && isSuperAdmin();
    }

    match /platform_plans/{planId} {
      allow read: if true;
      allow create, update, delete: if isValidId(planId) && isSuperAdmin();
    }

    match /platform_payments/{paymentId} {
      allow get: if isValidId(paymentId) && (
        isSuperAdmin() ||
        (isSignedIn() && resource.data.ownerId == request.auth.uid)
      );
      allow list: if isSuperAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if isValidId(paymentId) && isSignedIn() && (
        isSuperAdmin() || (
          incoming().ownerId == request.auth.uid &&
          incoming().status == 'pending' &&
          incoming().amount is number && incoming().amount >= 0 &&
          isShopOwner(incoming().shopId)
        )
      );
      allow update, delete: if isValidId(paymentId) && isSuperAdmin();
    }

    match /platform_activity_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isValidId(logId) && isSignedIn() && (
        isSuperAdmin() || (
          incoming().actorId == request.auth.uid &&
          incoming().keys().hasAll(['id', 'actorId', 'actorEmail', 'action', 'targetType', 'targetId', 'details', 'createdAt'])
        )
      );
      allow update, delete: if isSuperAdmin();
    }

    match /support_tickets/{ticketId} {
      allow get: if isValidId(ticketId) && (
        isSuperAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid)
      );
      allow list: if isSuperAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(ticketId) && isSignedIn() &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'open' &&
        incoming().subject is string && incoming().subject.size() >= 1 && incoming().subject.size() <= 200 &&
        incoming().message is string && incoming().message.size() >= 1 && incoming().message.size() <= 4000;
      allow update, delete: if isValidId(ticketId) && isSuperAdmin();
    }

    // Private Subscription Payment Receipts (Never public; Super Admin & uploading owner only)
    match /platform_payment_receipts/{receiptId} {
      allow get: if isValidId(receiptId) && (
        isSuperAdmin() ||
        (isSignedIn() && resource.data.ownerId == request.auth.uid)
      );
      allow list: if isSuperAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if isValidId(receiptId) && isSignedIn() &&
        incoming().keys().hasAll(['id', 'shopId', 'ownerId', 'contentType', 'base64Data', 'createdAt']) &&
        incoming().ownerId == request.auth.uid &&
        incoming().contentType is string && incoming().contentType.matches('image/(jpeg|jpg|png|webp|gif)') &&
        incoming().base64Data is string && incoming().base64Data.size() <= 550000;
      allow update, delete: if isValidId(receiptId) && isSuperAdmin();
    }

    // ====================================================
    // SLUG INDEX & STAFF INVITES
    // ====================================================

    match /shop_slugs/{slug} {
      allow get: if isValidSlug(slug);
      allow list: if isSuperAdmin();
      allow create: if isValidSlug(slug) && isSignedIn() && (
        isSuperAdmin() || (
          incoming().ownerId == request.auth.uid &&
          incoming().slug == slug &&
          incoming().shopId == slug &&
          isValidId(incoming().shopId) &&
          !exists(/databases/$(database)/documents/shops/$(incoming().shopId)) &&
          existsAfter(/databases/$(database)/documents/shops/$(incoming().shopId)) &&
          getAfter(/databases/$(database)/documents/shops/$(incoming().shopId)).data.ownerId == request.auth.uid
        )
      );
      allow update, delete: if isValidSlug(slug) && isSuperAdmin();
    }

    match /shop_invites/{inviteId} {
      allow get: if isValidId(inviteId) && (
        isSuperAdmin() ||
        (isSignedIn() && (
          (request.auth.token.email is string && resource.data.email is string &&
            resource.data.email.lower() == request.auth.token.email.lower()) ||
          isShopAdmin(resource.data.shopId)
        ))
      );
      allow list: if isSuperAdmin() || (
        isSignedIn() && (
          (request.auth.token.email is string && resource.data.email is string &&
            resource.data.email.lower() == request.auth.token.email.lower()) ||
          isShopAdmin(resource.data.shopId)
        )
      );
      allow create: if isValidId(inviteId) && isSignedIn() && (
        isSuperAdmin() || (
          isShopAdmin(incoming().shopId) &&
          incoming().role in ['shop_admin', 'shop_staff'] &&
          (incoming().role != 'shop_admin' || isShopOwner(incoming().shopId)) &&
          incoming().status == 'pending'
        )
      );
      allow update: if isValidId(inviteId) && isSignedIn() && (
        isSuperAdmin() ||
        isShopOwner(existing().shopId) ||
        (existing().status == 'pending' &&
          request.auth.token.email is string && existing().email is string &&
          existing().email.lower() == request.auth.token.email.lower() &&
          incoming().status == 'accepted' &&
          incoming().acceptedBy == request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'acceptedAt', 'acceptedBy']))
      );
      allow delete: if isValidId(inviteId) && isSignedIn() && (
        isSuperAdmin() || isShopAdmin(existing().shopId)
      );
    }

    // ====================================================
    // PUBLIC STOREFRONT DIRECTORY MIRROR (ZERO PRIVATE DATA)
    // ====================================================

    match /shops_public/{shopId} {
      allow get: if isValidId(shopId);
      allow list: if resource.data.status == 'active' || isSuperAdmin();
      allow create: if isValidId(shopId) && isValidShopPublicDoc(incoming(), shopId) && (
        isSuperAdmin() || (
          isSignedIn() &&
          exists(/databases/$(database)/documents/shops/$(shopId)) &&
          get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid &&
          incoming().status == 'active'
        )
      );
      allow update: if isValidId(shopId) && isValidShopPublicDoc(incoming(), shopId) && (
        isSuperAdmin() || (
          (isShopAdmin(shopId) || hasShopPermission(shopId, 'settings') || hasShopPermission(shopId, 'appearance')) &&
          incoming().status == existing().status &&
          incoming().slug == existing().slug
        )
      );
      allow delete: if isValidId(shopId) && isSuperAdmin();
    }

    // ====================================================
    // GLOBAL ONE-CNIC-ONE-SHOP REGISTRY & ARCHIVED RETENTION (PRIVACY-PRESERVING)
    // ====================================================

    match /cnic_registry/{hmacKey} {
      allow get: if isValidId(hmacKey) && isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isValidId(hmacKey) && isSignedIn() && (
        isSuperAdmin() || (
          hmacKey.matches('^[a-f0-9]{64}$') &&
          incoming().ownerId == request.auth.uid &&
          incoming().hmacKey == hmacKey &&
          incoming().status == 'active' &&
          !exists(/databases/$(database)/documents/cnic_registry/$(hmacKey)) &&
          incoming().keys().hasAll(['hmacKey', 'ownerId', 'shopId', 'cnicMasked', 'status', 'createdAt']) &&
          existsAfter(/databases/$(database)/documents/shops/$(incoming().shopId)) &&
          getAfter(/databases/$(database)/documents/shops/$(incoming().shopId)).data.ownerId == request.auth.uid &&
          getAfter(/databases/$(database)/documents/shops/$(incoming().shopId)).data.cnicHash == hmacKey
        )
      );
      allow update, delete: if isValidId(hmacKey) && isSuperAdmin();
    }

    match /archived_shops/{shopId} {
      allow read, write: if isValidId(shopId) && isSuperAdmin();
    }

    // ====================================================
    // USERS & TENANT MEMBERSHIPS
    // ====================================================

    match /users/{userId} {
      allow get: if isValidId(userId) && ((isSignedIn() && request.auth.uid == userId) || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isValidId(userId) && (
        (isSignedIn() && request.auth.uid == userId &&
          (!('role' in incoming()) || incoming().role in ['customer', 'shop_owner'] || isSuperAdminEmail()) &&
          (!('isBlocked' in incoming()) || incoming().isBlocked == false)) ||
        isSuperAdmin()
      );
      allow update: if isValidId(userId) && (
        (isSignedIn() && request.auth.uid == userId &&
          !incoming().diff(existing()).affectedKeys().hasAny(['role', 'isBlocked'])) ||
        isSuperAdmin()
      );
      allow delete: if isValidId(userId) && isSuperAdmin();

      match /shopMemberships/{shopId} {
        allow read: if isValidId(userId) && isValidId(shopId) && (
          (isSignedIn() && request.auth.uid == userId) || isSuperAdmin() || isShopAdmin(shopId)
        );
        allow create, update: if isValidId(userId) && isValidId(shopId) && isSignedIn() && (
          isSuperAdmin() ||
          isShopOwner(shopId) ||
          (isShopAdmin(shopId) && incoming().role == 'shop_staff') ||
          (request.auth.uid == userId && incoming().role == 'shop_owner' &&
            exists(/databases/$(database)/documents/shops/$(shopId)) &&
            get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid) ||
          (request.auth.uid == userId &&
            exists(/databases/$(database)/documents/shops/$(shopId)/staff/$(userId)) &&
            incoming().role == get(/databases/$(database)/documents/shops/$(shopId)/staff/$(userId)).data.role)
        );
        allow delete: if isValidId(userId) && isValidId(shopId) && (
          isSuperAdmin() || isShopAdmin(shopId)
        );
      }
    }

    // ====================================================
    // TENANT SHOPS (PRIVATE) & SCOPED SUBCOLLECTIONS
    // ====================================================

    match /shops/{shopId} {
      // Strictly NO public read on master shops/{shopId} (protects ownerEmail, ownerPhone, subscription, usage)
      allow get: if isValidId(shopId) && (isSuperAdmin() || isShopMember(shopId));
      allow list: if isSuperAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);

      allow create: if isValidId(shopId) && isSignedIn() && isValidSlug(incoming().slug) && (
        isSuperAdmin() || (
          incoming().ownerId == request.auth.uid &&
          incoming().slug == shopId &&
          incoming().status == 'active' &&
          incoming().subscription is map &&
          (incoming().subscription.planId == 'free-starter' || incoming().subscription.status == 'trial') &&
          incoming().cnicHash is string &&
          incoming().cnicHash.matches('^[a-f0-9]{64}$') &&
          incoming().cnicVerified == true &&
          incoming().cnicStatus == 'verified' &&
          existsAfter(/databases/$(database)/documents/cnic_registry/$(incoming().cnicHash)) &&
          getAfter(/databases/$(database)/documents/cnic_registry/$(incoming().cnicHash)).data.shopId == shopId &&
          getAfter(/databases/$(database)/documents/cnic_registry/$(incoming().cnicHash)).data.ownerId == request.auth.uid &&
          getAfter(/databases/$(database)/documents/cnic_registry/$(incoming().cnicHash)).data.status == 'active' &&
          existsAfter(/databases/$(database)/documents/shop_slugs/$(shopId)) &&
          getAfter(/databases/$(database)/documents/shop_slugs/$(shopId)).data.shopId == shopId
        )
      );

      allow update: if isValidId(shopId) && (
        isSuperAdmin() || (
          isShopMember(shopId) &&
          !incoming().diff(existing()).affectedKeys().hasAny([
            'ownerId', 'slug', 'status', 'subscription',
            'cnicHash', 'cnicLast4', 'cnicMasked', 'cnicVerified', 'cnicStatus', 'cnicUpdatedAt'
          ])
        )
      );

      allow delete: if isValidId(shopId) && isSuperAdmin();

      // Shop Staff RBAC (strict privilege escalation locks)
      match /staff/{staffUid} {
        allow get: if isValidId(staffUid) && (
          isShopMember(shopId) ||
          (isSignedIn() && request.auth.uid == staffUid)
        );
        allow list: if isShopMember(shopId);
        allow create: if isValidId(staffUid) && isSignedIn() && (
          isSuperAdmin() ||
          (isShopOwner(shopId) && incoming().role in ['shop_admin', 'shop_staff']) ||
          (isShopAdmin(shopId) && incoming().role == 'shop_staff') ||
          (request.auth.uid == staffUid &&
            incoming().role == 'shop_owner' &&
            exists(/databases/$(database)/documents/shops/$(shopId)) &&
            get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid) ||
          (request.auth.uid == staffUid &&
            incoming().inviteId is string &&
            exists(/databases/$(database)/documents/shop_invites/$(incoming().inviteId)) &&
            get(/databases/$(database)/documents/shop_invites/$(incoming().inviteId)).data.status == 'pending' &&
            request.auth.token.email is string &&
            get(/databases/$(database)/documents/shop_invites/$(incoming().inviteId)).data.email is string &&
            get(/databases/$(database)/documents/shop_invites/$(incoming().inviteId)).data.email.lower() == request.auth.token.email.lower() &&
            get(/databases/$(database)/documents/shop_invites/$(incoming().inviteId)).data.shopId == shopId &&
            incoming().role == get(/databases/$(database)/documents/shop_invites/$(incoming().inviteId)).data.role &&
            incoming().role in ['shop_admin', 'shop_staff'] &&
            incoming().permissions == get(/databases/$(database)/documents/shop_invites/$(incoming().inviteId)).data.permissions)
        );
        allow update: if isValidId(staffUid) && (
          isSuperAdmin() ||
          (isShopOwner(shopId) && existing().role != 'shop_owner' && incoming().role in ['shop_admin', 'shop_staff']) ||
          (isShopAdmin(shopId) && existing().role == 'shop_staff' && incoming().role == 'shop_staff')
        );
        allow delete: if isValidId(staffUid) && (
          isSuperAdmin() ||
          (isShopOwner(shopId) && existing().role != 'shop_owner') ||
          (isShopAdmin(shopId) && existing().role == 'shop_staff')
        );
      }

      // Shop Products
      match /products/{productId} {
        allow get: if isValidId(productId) && ((resource.data.isPublished == true) || hasShopPermission(shopId, 'products') || isShopMember(shopId));
        allow list: if (resource.data.isPublished == true) || isShopMember(shopId);
        allow create, delete: if isValidId(productId) && hasShopPermission(shopId, 'products');
        allow update: if isValidId(productId) && (
          hasShopPermission(shopId, 'products') ||
          hasShopPermission(shopId, 'inventory') ||
          hasShopPermission(shopId, 'pos') ||
          hasShopPermission(shopId, 'purchases')
        );
      }

      // Shop Categories
      match /categories/{categoryId} {
        allow read: if true;
        allow create, update, delete: if isValidId(categoryId) && hasShopPermission(shopId, 'categories');
      }

      // Shop Banners
      match /banners/{bannerId} {
        allow read: if true;
        allow create, update, delete: if isValidId(bannerId) && hasShopPermission(shopId, 'banners');
      }

      // Shop Settings: strictly split public storefront settings from private merchant account settings
      match /settings/{settingId} {
        allow get: if isValidId(settingId) && (
          settingId == 'public' ||
          isShopMember(shopId)
        );
        allow list: if isShopMember(shopId);
        allow create: if isValidId(settingId) && (
          isShopAdmin(shopId) ||
          hasShopPermission(shopId, 'settings') ||
          (isSignedIn() && exists(/databases/$(database)/documents/shops/$(shopId)) &&
           get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid)
        );
        allow update, delete: if isValidId(settingId) && (isShopAdmin(shopId) || hasShopPermission(shopId, 'settings'));
      }

      // Shop Pages (About, FAQ, Return Policy, Terms, Privacy)
      match /pages/{pageKey} {
        allow read: if true;
        allow create, update, delete: if isValidId(pageKey) && (
          hasShopPermission(shopId, 'appearance') ||
          hasShopPermission(shopId, 'settings')
        );
      }

      // Shop Coupons (only active/lookup public or tenant staff)
      match /coupons/{couponId} {
        allow get: if isValidId(couponId);
        allow list: if hasShopPermission(shopId, 'coupons') || isShopMember(shopId) || resource.data.isActive == true;
        allow create, update, delete: if isValidId(couponId) && hasShopPermission(shopId, 'coupons');
      }

      // Shop Carts
      match /carts/{cartId} {
        allow read, write: if isValidId(cartId) && ((isSignedIn() && request.auth.uid == cartId) || isShopMember(shopId));
      }

      // Shop Wishlists
      match /wishlists/{wishlistId} {
        allow read, write: if isValidId(wishlistId) && ((isSignedIn() && request.auth.uid == wishlistId) || isShopMember(shopId));
      }

      // Shop Reviews
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isValidId(reviewId) && isValidReview(incoming()) && (
          (isSignedIn() && incoming().userId == request.auth.uid) ||
          (!isSignedIn() && incoming().userId == 'guest_buyer')
        );
        allow update, delete: if isValidId(reviewId) && ((isSignedIn() && existing().userId == request.auth.uid) || isShopMember(shopId));
      }

      // Shop Orders — BLOCK public & guest reads to protect customer PII!
      match /orders/{orderId} {
        allow get: if isValidId(orderId) && (
          hasShopPermission(shopId, 'orders') ||
          isShopMember(shopId) ||
          (isSignedIn() && resource.data.userId == request.auth.uid)
        );
        allow list: if hasShopPermission(shopId, 'orders') ||
          isShopMember(shopId) ||
          (isSignedIn() && resource.data.userId == request.auth.uid);

        allow create: if isValidId(orderId) && isValidOrderCreate(incoming()) && (
          (incoming().userId == 'guest' && incoming().paymentStatus == 'pending' && incoming().orderStatus == 'Pending') ||
          (isSignedIn() && incoming().userId == request.auth.uid && incoming().paymentStatus == 'pending' && incoming().orderStatus == 'Pending') ||
          hasShopPermission(shopId, 'orders')
        );

        allow update: if isValidId(orderId) && (
          hasShopPermission(shopId, 'orders') || (
            isSignedIn() &&
            resource.data.userId == request.auth.uid &&
            existing().orderStatus == 'Pending' &&
            incoming().orderStatus == 'Cancelled' &&
            (!('pickupStatus' in incoming()) || incoming().pickupStatus == 'Cancelled') &&
            incoming().diff(existing()).affectedKeys().hasOnly(['orderStatus', 'pickupStatus', 'updatedAt'])
          )
        );
        allow delete: if isValidId(orderId) && isShopAdmin(shopId);
      }

      // Shop Non-PII Order Tracking (token-hashed document lookup or order member)
      match /order_tracking/{trackKey} {
        allow get: if isValidId(trackKey) && (
          isShopMember(shopId) ||
          // Tokenized tracking docs use lookup_<sha256Prefix> so knowing PK-XXXXXX alone cannot read unverified docs
          trackKey.matches('^trk_[a-f0-9]{32}$')
        );
        allow list: if isShopMember(shopId);
        allow create: if isValidId(trackKey) && isValidOrderTracking(incoming()) &&
          incoming().orderStatus == 'Pending' && incoming().paymentStatus == 'pending';
        allow update: if isValidId(trackKey) && (
          hasShopPermission(shopId, 'orders') || (
            isSignedIn() &&
            existing().orderStatus == 'Pending' &&
            incoming().orderStatus == 'Cancelled' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['orderStatus', 'updatedAt']) &&
            exists(/databases/$(database)/documents/shops/$(shopId)/orders/$(existing().orderId)) &&
            get(/databases/$(database)/documents/shops/$(shopId)/orders/$(existing().orderId)).data.userId == request.auth.uid
          )
        );
        allow delete: if isValidId(trackKey) && isShopAdmin(shopId);
      }

      // Shop Self-Pickup Slot Occupancy Reservations (strict capacity & atomic +1 guard)
      match /pickup_slots/{slotKey} {
        allow get, list: if isValidId(slotKey);
        allow create: if isValidId(slotKey) && (
          hasShopPermission(shopId, 'orders') || (
            incoming().keys().hasAll(['id', 'shopId', 'date', 'slotId', 'bookedCount', 'maxOrders', 'updatedAt']) &&
            incoming().keys().hasOnly(['id', 'shopId', 'date', 'slotId', 'bookedCount', 'maxOrders', 'updatedAt']) &&
            incoming().id == slotKey &&
            incoming().shopId == shopId &&
            incoming().date is string && incoming().date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
            incoming().slotId is string && incoming().slotId.size() <= 40 &&
            incoming().maxOrders is number && incoming().maxOrders >= 1 && incoming().maxOrders <= 500 &&
            incoming().bookedCount is number && incoming().bookedCount >= 0 && incoming().bookedCount <= 1 &&
            incoming().bookedCount <= incoming().maxOrders
          )
        );
        allow update: if isValidId(slotKey) && (
          hasShopPermission(shopId, 'orders') || (
            incoming().keys().hasAll(['id', 'shopId', 'date', 'slotId', 'bookedCount', 'maxOrders', 'updatedAt']) &&
            incoming().keys().hasOnly(['id', 'shopId', 'date', 'slotId', 'bookedCount', 'maxOrders', 'updatedAt']) &&
            incoming().id == slotKey &&
            incoming().shopId == shopId &&
            incoming().date == existing().date &&
            incoming().slotId == existing().slotId &&
            incoming().maxOrders == existing().maxOrders &&
            incoming().bookedCount is number &&
            incoming().bookedCount == existing().bookedCount + 1 &&
            incoming().bookedCount <= existing().maxOrders
          )
        );
        allow delete: if isValidId(slotKey) && isShopAdmin(shopId);
      }

      // Shop Inventory Logs
      match /inventory_logs/{logId} {
        allow get: if isValidId(logId) && hasShopPermission(shopId, 'inventory');
        allow list: if hasShopPermission(shopId, 'inventory');
        allow write: if isValidId(logId) && hasShopPermission(shopId, 'inventory');
      }

      // Shop Contact Messages
      match /contact_messages/{messageId} {
        allow create: if isValidId(messageId) && isValidContactMessage(incoming());
        allow read, update, delete: if isValidId(messageId) && isShopMember(shopId);
      }

      // Shop Newsletter Subscribers (public email signup, tenant read/manage only)
      match /newsletter_subscribers/{subId} {
        allow create: if isValidId(subId) &&
          incoming().keys().hasAll(['id', 'shopId', 'email', 'createdAt']) &&
          incoming().shopId == shopId &&
          incoming().email is string &&
          incoming().email.size() >= 5 &&
          incoming().email.size() <= 150 &&
          incoming().email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
        allow read, update, delete: if isValidId(subId) && isShopMember(shopId);
      }

      // Shop Private Checkout Payment Receipts (Create-only during checkout; NEVER public read)
      match /payment_receipts/{receiptId} {
        allow get: if isValidId(receiptId) && (
          isShopMember(shopId) ||
          (isSignedIn() && resource.data.uploaderUid == request.auth.uid)
        );
        allow list: if isShopMember(shopId) || (isSignedIn() && resource.data.uploaderUid == request.auth.uid);
        allow create: if isValidId(receiptId) &&
          incoming().keys().hasAll(['id', 'shopId', 'orderSessionId', 'contentType', 'base64Data', 'createdAt']) &&
          incoming().shopId == shopId &&
          incoming().contentType is string &&
          incoming().contentType.matches('image/(jpeg|jpg|png|webp|gif)') &&
          incoming().base64Data is string &&
          incoming().base64Data.size() <= 500000;
        allow update, delete: if isValidId(receiptId) && isShopAdmin(shopId);
      }

      // Shop Customers Directory
      match /customers/{customerId} {
        allow get: if isValidId(customerId) && (
          hasShopPermission(shopId, 'customers') ||
          hasShopPermission(shopId, 'pos') ||
          hasShopPermission(shopId, 'khata') ||
          isShopMember(shopId)
        );
        allow list: if hasShopPermission(shopId, 'customers') ||
          hasShopPermission(shopId, 'pos') ||
          hasShopPermission(shopId, 'khata') ||
          isShopMember(shopId);
        allow write: if isValidId(customerId) && (
          hasShopPermission(shopId, 'customers') ||
          hasShopPermission(shopId, 'pos') ||
          hasShopPermission(shopId, 'khata')
        );
      }

      // Stage 1 Retail Operations Subcollections (Strictly Tenant-Isolated)
      match /suppliers/{supplierId} {
        allow read: if isShopMember(shopId);
        allow write: if isValidId(supplierId) && (
          hasShopPermission(shopId, 'suppliers') ||
          hasShopPermission(shopId, 'inventory') ||
          isShopAdmin(shopId)
        );
      }

      match /purchases/{purchaseId} {
        allow read: if isShopMember(shopId);
        allow write: if isValidId(purchaseId) && (
          hasShopPermission(shopId, 'purchases') ||
          hasShopPermission(shopId, 'inventory') ||
          isShopAdmin(shopId)
        );
      }

      match /pos_sales/{saleId} {
        allow read: if isShopMember(shopId);
        allow write: if isValidId(saleId) && (
          hasShopPermission(shopId, 'pos') ||
          hasShopPermission(shopId, 'orders') ||
          isShopAdmin(shopId)
        );
      }

      match /stock_movements/{movementId} {
        allow read: if isShopMember(shopId);
        allow write: if isValidId(movementId) && (
          hasShopPermission(shopId, 'inventory') ||
          hasShopPermission(shopId, 'pos') ||
          hasShopPermission(shopId, 'purchases') ||
          isShopAdmin(shopId)
        );
      }

      match /khata_ledger/{entryId} {
        allow read: if isShopMember(shopId);
        allow write: if isValidId(entryId) && (
          hasShopPermission(shopId, 'khata') ||
          hasShopPermission(shopId, 'customers') ||
          hasShopPermission(shopId, 'pos') ||
          isShopAdmin(shopId)
        );
      }

      match /expenses/{expenseId} {
        allow read: if isShopMember(shopId);
        allow write: if isValidId(expenseId) && (
          hasShopPermission(shopId, 'reports') ||
          isShopAdmin(shopId)
        );
      }

      // Shop Notifications & Activity Logs
      match /notifications/{notifId} {
        allow create: if isValidId(notifId) && (
          isShopMember(shopId) || (
            incoming().type == 'order' &&
            incoming().isRead == false &&
            incoming().keys().hasOnly(['id', 'title', 'message', 'type', 'isRead', 'link', 'createdAt']) &&
            incoming().message is string && incoming().message.size() <= 240
          )
        );
        allow get: if isValidId(notifId) && isShopMember(shopId);
        allow list: if isShopMember(shopId);
        allow update, delete: if isValidId(notifId) && isShopMember(shopId);
      }

      match /activity_logs/{logId} {
        allow get: if isValidId(logId) && isShopMember(shopId);
        allow list: if isShopMember(shopId);
        allow create: if isValidId(logId) && isShopMember(shopId) && incoming().actorId == request.auth.uid;
        allow update, delete: if isValidId(logId) && isShopAdmin(shopId);
      }
    }

    // ====================================================
    // SALES PORTALS (SUPER ADMIN, SALES MANAGER, SALESMAN, REFERRAL AGENT RBAC)
    // ====================================================

    match /salesSettings/{docId} {
      // Shop owners, customers, and referral agents cannot read internal commission tier formulas
      allow read: if isSuperAdmin() || hasSalesClaimRole(['sales_manager', 'salesman', 'senior_salesman']);
      allow write: if isValidId(docId) && isSuperAdmin();
    }

    match /salesReferralIndex/{code} {
      allow get: if isValidId(code);
      allow list: if isSuperAdmin();
      allow create, delete: if isValidId(code) && isSuperAdmin();
      allow update: if isValidId(code) && (
        isSuperAdmin() ||
        (isSignedIn() && resource.data.salesmanUid == request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['qrScanCount', 'updatedAt']))
      );
    }

    match /salesMembers/{memberId} {
      allow get: if isValidId(memberId) && (
        isSuperAdmin() || (
          isSignedIn() && (
            resource.data.uid == request.auth.uid ||
            resource.data.assignedManagerUid == request.auth.uid ||
            (request.auth.token.email_verified == true && resource.data.email == request.auth.token.email)
          )
        )
      );
      allow list: if isSuperAdmin() || (
        isSignedIn() && (
          resource.data.uid == request.auth.uid ||
          resource.data.assignedManagerUid == request.auth.uid ||
          (request.auth.token.email_verified == true && resource.data.email == request.auth.token.email)
        )
      );
      // Strictly never allow super_admin role in salesMembers
      allow create: if isValidId(memberId) && isSuperAdmin() && isAllowedSalesRole(incoming().role);
      // Self-service affiliate partner registration (strictly locked to caller UID & pending_approval referral_agent)
      allow create: if isValidId(memberId) &&
        isSignedIn() &&
        memberId == ('sm_ref_' + request.auth.uid) &&
        incoming().uid == request.auth.uid &&
        incoming().createdBy == request.auth.uid &&
        incoming().role == 'referral_agent' &&
        incoming().accountStatus == 'pending_approval' &&
        incoming().inviteStatus == 'pending';
      allow delete: if isValidId(memberId) && isSuperAdmin();
      allow update: if isValidId(memberId) && (
        (isSuperAdmin() && (!('role' in incoming()) || isAllowedSalesRole(incoming().role))) || (
          isSignedIn() &&
          (resource.data.uid == request.auth.uid ||
            (request.auth.token.email_verified == true && resource.data.email == request.auth.token.email)) &&
          incoming().uid == request.auth.uid &&
          incoming().role == existing().role &&
          isAllowedSalesRole(incoming().role) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'uid', 'inviteStatus', 'acceptedAt', 'accountStatus',
            'lastLoginAt', 'lastActivityAt', 'updatedAt', 'payoutDetails'
          ]) &&
          (existing().accountStatus == 'invited' || incoming().accountStatus == existing().accountStatus)
        )
      );
    }

    match /salesTeams/{teamId} {
      allow get: if isValidId(teamId) && (
        isSuperAdmin() ||
        (isSignedIn() && resource.data.managerUid == request.auth.uid && hasSalesClaimRole(['sales_manager']))
      );
      allow list: if isSuperAdmin() || (
        isSignedIn() && resource.data.managerUid == request.auth.uid && hasSalesClaimRole(['sales_manager'])
      );
      allow write: if isValidId(teamId) && isSuperAdmin();
    }

    match /salesLeads/{leadId} {
      allow get: if isValidId(leadId) && (
        isSuperAdmin() || (
          isSignedIn() && (
            resource.data.assignedSalesmanUid == request.auth.uid ||
            resource.data.assignedManagerUid == request.auth.uid
          )
        )
      );
      allow list: if isSuperAdmin() || (
        isSignedIn() && (
          resource.data.assignedSalesmanUid == request.auth.uid ||
          resource.data.assignedManagerUid == request.auth.uid
        )
      );
      allow create: if isValidId(leadId) && (
        isSuperAdmin() || (
          isSignedIn() &&
          incoming().assignedSalesmanUid == request.auth.uid &&
          hasSalesClaimRole(['salesman', 'senior_salesman', 'sales_manager'])
        )
      );
      allow update: if isValidId(leadId) && (
        isSuperAdmin() || (
          isSignedIn() &&
          existing().assignedSalesmanUid == request.auth.uid &&
          incoming().assignedSalesmanUid == existing().assignedSalesmanUid &&
          incoming().assignedSalesmanId == existing().assignedSalesmanId &&
          incoming().assignedManagerUid == existing().assignedManagerUid
        ) || (
          isSignedIn() &&
          existing().assignedManagerUid == request.auth.uid &&
          incoming().assignedManagerUid == existing().assignedManagerUid &&
          incoming().assignedSalesmanId is string &&
          isManagerOfSalesMember(incoming().assignedSalesmanId)
        )
      );
      allow delete: if isValidId(leadId) && isSuperAdmin();
    }

    match /salesActivities/{activityId} {
      allow get: if isValidId(activityId) && (
        isSuperAdmin() ||
        (isSignedIn() && (
          resource.data.salesmanUid == request.auth.uid ||
          isManagerOfSalesMember(resource.data.salesmanId)
        ))
      );
      allow list: if isSuperAdmin() || (
        isSignedIn() && (
          resource.data.salesmanUid == request.auth.uid ||
          isManagerOfSalesMember(resource.data.salesmanId)
        )
      );
      allow create: if isValidId(activityId) && (
        isSuperAdmin() || (
          isSignedIn() &&
          incoming().salesmanUid == request.auth.uid &&
          hasSalesClaimRole(['salesman', 'senior_salesman', 'sales_manager'])
        )
      );
      allow update, delete: if isValidId(activityId) && isSuperAdmin();
    }

    match /salesTargets/{targetId} {
      allow get: if isValidId(targetId) && (
        isSuperAdmin() ||
        (isSignedIn() && (
          resource.data.salesmanUid == request.auth.uid ||
          isManagerOfSalesMember(resource.data.salesmanId)
        ))
      );
      allow list: if isSuperAdmin() || (
        isSignedIn() && (
          resource.data.salesmanUid == request.auth.uid ||
          isManagerOfSalesMember(resource.data.salesmanId)
        )
      );
      allow write: if isValidId(targetId) && isSuperAdmin();
    }

    match /referralAttributions/{shopId} {
      allow get: if isValidId(shopId) && (
        isSuperAdmin() ||
        (isSignedIn() && (resource.data.salesmanUid == request.auth.uid || resource.data.ownerId == request.auth.uid))
      );
      allow list: if isSuperAdmin() || (
        isSignedIn() && (resource.data.salesmanUid == request.auth.uid || resource.data.ownerId == request.auth.uid)
      );
      allow create: if isValidId(shopId) && isSignedIn() && (
        isSuperAdmin() || (
          incoming().ownerId == request.auth.uid &&
          incoming().shopId == shopId &&
          incoming().attributionStatus in ['registered', 'rejected_self_referral'] &&
          incoming().totalRevenueGenerated == 0
        )
      );
      allow update, delete: if isValidId(shopId) && isSuperAdmin();
    }

    // Strict financial isolation: salesmen can READ their own commissions & payouts ONLY; NEVER edit!
    match /commissionLedger/{commissionId} {
      allow get: if isValidId(commissionId) && (
        isSuperAdmin() || (isSignedIn() && resource.data.salesmanUid == request.auth.uid)
      );
      allow list: if isSuperAdmin() || (isSignedIn() && resource.data.salesmanUid == request.auth.uid);
      allow create, update, delete: if isValidId(commissionId) && isSuperAdmin();
    }

    match /commissionPayouts/{payoutId} {
      allow get: if isValidId(payoutId) && (
        isSuperAdmin() || (isSignedIn() && resource.data.salesmanUid == request.auth.uid)
      );
      allow list: if isSuperAdmin() || (isSignedIn() && resource.data.salesmanUid == request.auth.uid);
      allow create, update, delete: if isValidId(payoutId) && isSuperAdmin();
    }

    // Authorized business expenses: salesmen submit own as pending only; NEVER self-approve
    match /salesExpenses/{expenseId} {
      allow get: if isValidId(expenseId) && (
        isSuperAdmin() || (isSignedIn() && resource.data.salesmanUid == request.auth.uid)
      );
      allow list: if isSuperAdmin() || (isSignedIn() && resource.data.salesmanUid == request.auth.uid);
      allow create: if isValidId(expenseId) && (
        isSuperAdmin() || (
          isSignedIn() &&
          incoming().salesmanUid == request.auth.uid &&
          incoming().status == 'pending' &&
          incoming().amount is number && incoming().amount > 0 &&
          hasSalesClaimRole(['salesman', 'senior_salesman', 'sales_manager'])
        )
      );
      allow update, delete: if isValidId(expenseId) && isSuperAdmin();
    }

    // Team bonus recommendations: Sales Manager submits ONLY for own team member as pending; Super Admin approves
    match /salesBonusRecommendations/{recId} {
      allow get: if isValidId(recId) && (
        isSuperAdmin() || (isSignedIn() && resource.data.managerUid == request.auth.uid)
      );
      allow list: if isSuperAdmin() || (isSignedIn() && resource.data.managerUid == request.auth.uid);
      allow create: if isValidId(recId) && (
        isSuperAdmin() || (
          isSignedIn() &&
          incoming().managerUid == request.auth.uid &&
          incoming().status == 'pending' &&
          incoming().recommendedAmount is number && incoming().recommendedAmount > 0 &&
          isManagerOfSalesMember(incoming().salesmanId) &&
          hasSalesClaimRole(['sales_manager'])
        )
      );
      allow update, delete: if isValidId(recId) && isSuperAdmin();
    }

    // Approved sales collateral: readable by active sales members & referral agents; Super Admin write only
    match /salesMaterials/{materialId} {
      allow get, list: if isSuperAdmin() || hasSalesClaimRole(['salesman', 'senior_salesman', 'sales_manager', 'referral_agent']);
      allow create, update, delete: if isValidId(materialId) && isSuperAdmin();
    }

    match /salesNotifications/{notifId} {
      allow get: if isValidId(notifId) && (
        isSuperAdmin() || (isSignedIn() && resource.data.recipientUid == request.auth.uid)
      );
      allow list: if isSuperAdmin() || (isSignedIn() && resource.data.recipientUid == request.auth.uid);
      allow create: if isValidId(notifId) && (
        isSuperAdmin() || (
          isSignedIn() && (
            incoming().recipientUid == request.auth.uid ||
            isManagerOfSalesMember(incoming().recipientSalesmanId)
          )
        )
      );
      allow update: if isValidId(notifId) && (
        isSuperAdmin() || (
          isSignedIn() &&
          resource.data.recipientUid == request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['isRead'])
        )
      );
      allow delete: if isValidId(notifId) && isSuperAdmin();
    }

    match /salesQrEvents/{eventId} {
      allow get: if isValidId(eventId) && isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isValidId(eventId) &&
        incoming().keys().hasAll(['id', 'salesmanId', 'referralCode', 'source', 'createdAt']) &&
        incoming().keys().hasOnly(['id', 'salesmanId', 'referralCode', 'source', 'userAgent', 'convertedShopId', 'createdAt']) &&
        incoming().id == eventId &&
        incoming().salesmanId is string && incoming().salesmanId.size() >= 1 && incoming().salesmanId.size() <= 128 &&
        incoming().referralCode is string && incoming().referralCode.size() >= 2 && incoming().referralCode.size() <= 64 &&
        incoming().source in ['qr_scan', 'referral_link'] &&
        incoming().createdAt is string && incoming().createdAt.size() <= 50;
      allow update, delete: if isValidId(eventId) && isSuperAdmin();
    }

    match /salesAuditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isValidId(logId) && isSignedIn() && incoming().actorUid == request.auth.uid;
      // Immutable financial & operational audit logs
      allow update, delete: if false;
    }

    // ====================================================
    // LEGACY COLLECTIONS (Strict Super Admin Only Writes; Public Read Restricted)
    // ====================================================
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isSuperAdmin() || (isSignedIn() && request.auth.uid == adminId));
      allow list: if isSuperAdmin();
      allow create, update, delete: if isValidId(adminId) && isSuperAdminEmail();
    }
    match /products/{productId} {
      allow read: if isSuperAdmin() || resource.data.isPublished == true;
      allow write: if isSuperAdmin();
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /settings/{settingId} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }
    match /coupons/{couponId} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }
    match /orders/{orderId} {
      allow read, write: if isSuperAdmin();
    }
    match /order_tracking/{orderNumber} {
      allow read, write: if isSuperAdmin();
    }
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /inventory_logs/{logId} {
      allow read, write: if isSuperAdmin();
    }
    match /contact_messages/{messageId} {
      allow read, write: if isSuperAdmin();
    }

    // ====================================================
    // ISOLATED DEMO SUPER ADMIN SANDBOX (/demo_env/default & /demo_admins)
    // Strictly air-gapped from all production collections & admins
    // ====================================================
    match /demo_admins/{adminId} {
      allow get: if isValidId(adminId) && (isSuperAdmin() || (isDemoSuperAdmin() && request.auth.uid == adminId));
      allow list: if isSuperAdmin();
      allow create, update, delete: if isValidId(adminId) && isSuperAdmin();
    }

    match /demo_env/{envId} {
      allow get: if envId == 'default' && (isSuperAdmin() || isDemoSuperAdmin());
      allow list, create, update, delete: if envId == 'default' && isSuperAdmin();

      match /shops/{shopId} {
        allow read, write: if envId == 'default' && isValidId(shopId) && (isSuperAdmin() || isDemoSuperAdmin());

        match /{subCol}/{subDocId} {
          allow get, create, update, delete: if envId == 'default' && isValidId(shopId) && isValidId(subDocId) && (isSuperAdmin() || isDemoSuperAdmin());
          allow list: if envId == 'default' && isValidId(shopId) && (isSuperAdmin() || isDemoSuperAdmin());
        }
      }

      match /{demoCollection}/{docId} {
        allow get, create, update, delete: if envId == 'default' &&
          !(demoCollection in ['platform_admins', 'admins']) &&
          isValidId(docId) &&
          (isSuperAdmin() || isDemoSuperAdmin());
        allow list: if envId == 'default' &&
          !(demoCollection in ['platform_admins', 'admins']) &&
          (isSuperAdmin() || isDemoSuperAdmin());
      }
    }
  }
}
