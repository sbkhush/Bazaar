# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: Server HTTP port (defaults to 3000 in dev, injected as 8080 in Cloud Run).
PORT="3000"

# VITE_BASE_PATH: Vite base URL path ('/' for root/Cloud Run, '/<repo>/' for GitHub Pages).
VITE_BASE_PATH="/"

# ALLOWED_ORIGINS: Optional comma-separated list of CORS origins allowed on Express /api routes.
ALLOWED_ORIGINS=""

# VITE_API_BASE_URL: Separate hosted Express backend URL when frontend is deployed to GitHub Pages.
VITE_API_BASE_URL=""

# CNIC_HMAC_SECRET: Server-side secret used to compute deterministic HMAC-SHA256 hashes for CNIC deduplication.
# Keep private on server / Cloud Functions environment only — NEVER prefix with VITE_.
CNIC_HMAC_SECRET="CHANGE_ME_STRONG_SERVER_HMAC_SECRET"

# VITE_FIREBASE_APP_CHECK_SITE_KEY: Optional public reCAPTCHA v3 site key for Firebase App Check enforcement in production.
VITE_FIREBASE_APP_CHECK_SITE_KEY=""
