rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 1. Default Deny All
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isNotDemoAccount() {
      return !isSignedIn() || (
        request.auth.token.demo_super_admin != true &&
        request.auth.token.account_type != 'DEMO' &&
        request.auth.token.email != 'demo-admin@sbkhush.com'
      );
    }

    function isDemoSuperAdmin() {
      return isSignedIn() &&
        request.auth.token.demo_super_admin == true &&
        request.auth.token.account_type == 'DEMO' &&
        request.auth.token.email == 'demo-admin@sbkhush.com';
    }

    function isSuperAdmin() {
      return isSignedIn() && isNotDemoAccount() && (
        request.auth.token.super_admin == true ||
        (request.auth.token.email == 'hasanaamir815@gmail.com' &&
         request.auth.token.email_verified == true)
      );
    }

    // Tenant authorization via Firebase Auth Custom Claims (provisioned by Cloud Functions)
    function isShopMember(shopId) {
      return isSignedIn() && isNotDemoAccount() && (
        isSuperAdmin() ||
        (request.auth.token.shops != null &&
         shopId in request.auth.token.shops &&
         request.auth.token.shops[shopId] in ['shop_owner', 'shop_admin', 'shop_staff'])
      );
    }

    function isShopAdmin(shopId) {
      return isSignedIn() && isNotDemoAccount() && (
        isSuperAdmin() ||
        (request.auth.token.shops != null &&
         shopId in request.auth.token.shops &&
         request.auth.token.shops[shopId] in ['shop_owner', 'shop_admin'])
      );
    }

    function isValidImageUpload() {
      return request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif)');
    }

    // ----------------------------------------------------
    // PUBLIC STOREFRONT ASSETS (Public Read, Strict Tenant Write/Delete)
    // ----------------------------------------------------
    match /shops/{shopId}/logo/{allPaths=**} {
      allow read: if true;
      allow create, update: if isShopAdmin(shopId) && isValidImageUpload();
      allow delete: if isShopAdmin(shopId);
    }

    match /shops/{shopId}/products/{allPaths=**} {
      allow read: if true;
      allow create, update: if isShopMember(shopId) && isValidImageUpload();
      allow delete: if isShopMember(shopId);
    }

    match /shops/{shopId}/banners/{allPaths=**} {
      allow read: if true;
      allow create, update: if isShopMember(shopId) && isValidImageUpload();
      allow delete: if isShopMember(shopId);
    }

    match /shops/{shopId}/categories/{allPaths=**} {
      allow read: if true;
      allow create, update: if isShopMember(shopId) && isValidImageUpload();
      allow delete: if isShopMember(shopId);
    }

    match /shops/{shopId}/pages/{allPaths=**} {
      allow read: if true;
      allow create, update: if isShopMember(shopId) && isValidImageUpload();
      allow delete: if isShopMember(shopId);
    }

    // ----------------------------------------------------
    // PRIVATE FINANCIAL & SUBSCRIPTION PROOFS (NEVER Public Read)
    // ----------------------------------------------------

    // Customer Checkout Payment Proofs (Write-once for verified order session; Private Read)
    match /shops/{shopId}/payments/{orderSessionId}/{fileName} {
      allow read: if isShopMember(shopId) || (
        isSignedIn() && resource.metadata.uploaderUid == request.auth.uid
      );
      allow create: if isValidImageUpload() &&
        request.resource.metadata != null &&
        request.resource.metadata.shopId == shopId &&
        request.resource.metadata.purpose == 'checkout_payment_proof' &&
        (isShopMember(shopId) || (isSignedIn() ? request.resource.metadata.uploaderUid == request.auth.uid : request.resource.metadata.uploaderUid == 'guest'));
      allow update: if isShopMember(shopId) && isValidImageUpload();
      allow delete: if isShopAdmin(shopId);
    }

    // Tenant Subscription Payment Proofs
    match /shops/{shopId}/subscription/{allPaths=**} {
      allow read: if isShopAdmin(shopId);
      allow create, update: if isShopAdmin(shopId) &&
        isValidImageUpload() &&
        request.resource.metadata != null &&
        request.resource.metadata.shopId == shopId &&
        request.resource.metadata.uploaderUid == request.auth.uid;
      allow delete: if isShopAdmin(shopId);
    }

    // Platform-Level Branding & OG Images (Public Read, Super Admin Write/Delete)
    match /platform/brand/{allPaths=**} {
      allow read: if true;
      allow create, update: if isSuperAdmin() && isValidImageUpload();
      allow delete: if isSuperAdmin();
    }

    // Platform-Level Subscription Proofs (Restricted exclusively to Super Admin & submitting Shop Admin)
    match /platform/payments/{shopId}/{fileName} {
      allow read: if isShopAdmin(shopId);
      allow create, update: if isShopAdmin(shopId) &&
        isValidImageUpload() &&
        request.resource.metadata != null &&
        request.resource.metadata.shopId == shopId &&
        request.resource.metadata.uploaderUid == request.auth.uid;
      allow delete: if isSuperAdmin();
    }

    // Sales team claim helper (never grants shop or Super Admin storage access)
    function isActiveSalesClaim() {
      return isSignedIn() && (
        request.auth.token.sales_role in ['salesman', 'senior_salesman', 'sales_manager', 'referral_agent']
      );
    }

    // Sales Approved Collateral Materials (Super Admin write only; active sales & referral roles read only)
    match /sales/materials/{allPaths=**} {
      allow read: if isSuperAdmin() || isActiveSalesClaim();
      allow create, update, delete: if isSuperAdmin();
    }

    // Sales Expense Receipts (Own upload & read only; Super Admin delete/review)
    match /sales/expenses/{userId}/{expenseId}/{fileName} {
      allow read: if isSuperAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create, update: if isSignedIn() &&
        request.auth.uid == userId &&
        isValidImageUpload() &&
        request.resource.metadata != null &&
        request.resource.metadata.uploaderUid == request.auth.uid;
      allow delete: if isSuperAdmin();
    }

    // User Profile Avatars
    match /users/{userId}/profile/{fileName} {
      allow read: if isSignedIn() && isNotDemoAccount() && (request.auth.uid == userId || isSuperAdmin());
      allow create, update: if isSignedIn() && isNotDemoAccount() && request.auth.uid == userId && isValidImageUpload();
      allow delete: if isSignedIn() && isNotDemoAccount() && (request.auth.uid == userId || isSuperAdmin());
    }

    // Isolated Demo Super Admin Storage Sandbox
    match /demo_env/default/{allPaths=**} {
      allow read: if isSuperAdmin() || isDemoSuperAdmin();
      allow create, update: if (isSuperAdmin() || isDemoSuperAdmin()) && isValidImageUpload();
      allow delete: if isSuperAdmin() || isDemoSuperAdmin();
    }
  }
}
